# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: model to use. Any chat model that supports structured outputs works.
OPENAI_MODEL=gpt-5.5

# Optional: where the SQLite database lives (default: ./data/job-tracker.db)
# DATABASE_PATH=./data/job-tracker.db
